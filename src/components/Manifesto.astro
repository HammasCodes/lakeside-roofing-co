---
import { stats } from '../data/site';

/**
 * Oversized serif statement with a word-by-word rise reveal.
 *
 * Words are split here at build time rather than with GSAP's SplitText:
 *  - no plugin dependency or licensing question
 *  - no runtime DOM churn
 *  - the full sentence is in the served HTML for crawlers
 *
 * Real spaces are preserved between the inline-block spans, so the text still
 * reads and selects as one sentence for screen readers. The .word-mask class
 * (global.css) carries the layout fix that keeps the masked inline-blocks from
 * pushing every line a full line-height below their own container.
 */
const statement = 'We build roofs the way the house deserves. Slowly, precisely, and only once.';
const words = statement.split(' ');
---

<section class="mx-auto max-w-[88rem] px-6 py-32 lg:px-10 lg:py-48">
	<div class="grid grid-cols-1 gap-14 lg:grid-cols-12 lg:gap-20">
		<div class="lg:col-span-9">
			<h2
				data-reveal-word
				class="word-mask font-display text-[clamp(2rem,5.2vw,4.5rem)] font-normal tracking-[-0.03em]"
			>
				{
					words.map((word, i) => (
						<>
							<span>
								<span>{word}</span>
							</span>
							{i < words.length - 1 ? ' ' : ''}
						</>
					))
				}
			</h2>
		</div>

		<div class="lg:col-span-3 lg:pt-3">
			<p class="text-[1.0625rem] leading-relaxed text-ink/60 text-pretty" data-reveal>
				Sixteen years in Central Texas, one crew at a time, no subcontracted
				labour. Every system we specify is chosen for your roof pitch,
				exposure and ventilation load, not for what happens to be on the truck.
			</p>
		</div>
	</div>

	<dl
		data-reveal-group
		class="mt-28 grid grid-cols-2 gap-x-8 gap-y-12 border-t border-ink/15 pt-12 lg:mt-36 lg:grid-cols-4"
	>
		{
			stats.map((stat) => (
				<div data-reveal>
					<dt class="font-display text-[clamp(2.25rem,4vw,3.5rem)] leading-none tracking-[-0.02em]">
						{stat.value}
					</dt>
					<dd class="mt-3 text-[0.8125rem] uppercase tracking-[0.14em] text-ink/50">
						{stat.label}
					</dd>
				</div>
			))
		}
	</dl>
</section>
