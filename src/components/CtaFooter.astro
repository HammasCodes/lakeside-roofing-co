---
import { site, nav } from '../data/site';

const year = new Date().getFullYear();

// TODO: point this at a real form backend (Formspree / Web3Forms / Netlify
// Forms) before launch. The site builds to static output, so there is no
// server to POST to. Until this is set, the tel: and mailto: links beside the
// form are the working contact paths.
const FORM_ENDPOINT = '';

const services = [
	'Roof replacement',
	'Storm and hail restoration',
	'Repair and maintenance',
	'Inspection only',
	'Something else',
];

const fieldClass =
	'mt-2.5 w-full rounded-lg border border-white/20 bg-white/[0.06] px-4 py-3.5 text-white transition-colors duration-300 placeholder-white/35 hover:border-white/35 focus:border-clay-light focus:outline-none';
const labelClass = 'block text-[0.875rem] text-white/70';
---

<section id="contact" class="scroll-mt-28 bg-ink text-white">
	<div class="mx-auto grid max-w-[88rem] grid-cols-1 gap-16 px-6 py-28 lg:grid-cols-12 lg:gap-20 lg:px-10 lg:py-40">
		<div class="lg:col-span-5">
			<p class="eyebrow text-clay-light" data-reveal>Get started</p>
			<h2
				class="mt-7 font-display text-[clamp(2rem,4.4vw,3.6rem)] font-normal leading-[1.04] tracking-[-0.03em] text-balance"
				data-reveal
			>
				Book your free
				{' '}<span class="text-white/55 italic">inspection.</span>
			</h2>
			<p class="mt-7 max-w-md text-[1.0625rem] leading-relaxed text-white/65 text-pretty" data-reveal>
				A senior estimator will walk your property, document any damage, and
				give you a written scope, whether or not you hire us.
			</p>

			<dl class="mt-14 space-y-7 text-[0.875rem]" data-reveal>
				<div>
					<dt class="text-white/50">Call</dt>
					<dd class="mt-1.5">
						<a href={`tel:${site.phone}`} class="link-wipe text-[1.125rem] transition-colors hover:text-clay-light">
							{site.phoneDisplay}
						</a>
					</dd>
				</div>
				<div>
					<dt class="text-white/50">Email</dt>
					<dd class="mt-1.5">
						<a href={`mailto:${site.email}`} class="link-wipe text-[1.125rem] transition-colors hover:text-clay-light">
							{site.email}
						</a>
					</dd>
				</div>
				<div>
					<dt class="text-white/50">Workshop</dt>
					<dd class="mt-1.5 text-[1.125rem] text-white/85">
						<address class="not-italic">
							{site.address.street}<br />
							{site.address.city}, {site.address.region} {site.address.postalCode}
						</address>
					</dd>
				</div>
			</dl>
		</div>

		<div class="lg:col-span-6 lg:col-start-7">
			<form
				class="grid grid-cols-1 gap-5 sm:grid-cols-2"
				method="post"
				action={FORM_ENDPOINT || undefined}
				data-contact-form
				data-reveal
			>
				<div>
					<label for="name" class={labelClass}>Full name</label>
					<input id="name" name="name" type="text" required autocomplete="name" class={fieldClass} />
				</div>

				<div>
					<label for="phone" class={labelClass}>Phone</label>
					<input id="phone" name="phone" type="tel" required autocomplete="tel" class={fieldClass} />
				</div>

				<div class="sm:col-span-2">
					<label for="email" class={labelClass}>Email</label>
					<input id="email" name="email" type="email" required autocomplete="email" class={fieldClass} />
				</div>

				<div class="sm:col-span-2">
					<label for="service" class={labelClass}>What do you need?</label>
					<select id="service" name="service" class={fieldClass}>
						{services.map((service) => <option value={service} class="bg-ink">{service}</option>)}
					</select>
				</div>

				<div class="sm:col-span-2">
					<label for="message" class={labelClass}>
						Anything we should know? <span class="text-white/60">(optional)</span>
					</label>
					<textarea id="message" name="message" rows="4" class={`${fieldClass} resize-y`}></textarea>
				</div>

				<div class="sm:col-span-2 sm:flex sm:items-center sm:gap-6">
					<button
						type="submit"
						class="group/submit inline-flex w-full items-center justify-center gap-2.5 rounded-full bg-white px-9 py-4 font-medium text-ink transition-colors duration-300 hover:bg-clay-light sm:w-auto"
					>
						Request my free inspection
						<svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true" class="transition-transform duration-300 group-hover/submit:translate-x-1">
							<path d="M2 8h12M9 3l5 5-5 5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
						</svg>
					</button>
					<p data-form-note role="status" class="mt-4 text-[0.875rem] text-white/60 sm:mt-0">
						We reply within one business day.
					</p>
				</div>
			</form>
		</div>
	</div>

	<footer class="border-t border-white/10">
		<div class="mx-auto max-w-[88rem] px-6 py-16 lg:px-10">
			<div class="grid grid-cols-2 gap-10 md:grid-cols-4">
				<div class="col-span-2 md:col-span-1">
					<div class="flex items-center gap-2.5">
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
							<path d="M2 12 12 3l10 9" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" />
							<path d="M5 10.5V21h14V10.5" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" />
						</svg>
						<span class="font-display text-[1.0625rem]">{site.name}</span>
					</div>
					<p class="mt-5 max-w-xs text-[0.875rem] leading-relaxed text-white/55">
						Premium roofing and storm restoration across Central Texas since {site.founded}.
					</p>
				</div>

				<nav aria-label="Sections">
					<h2 class="text-[0.875rem] font-medium">Explore</h2>
					<ul class="mt-5 space-y-3 text-[0.875rem] text-white/55">
						{
							nav.map((item) => (
								<li>
									<a href={item.href} class="inline-block py-1 transition-colors hover:text-white">
										{item.label}
									</a>
								</li>
							))
						}
						<li><a href="#contact" class="inline-block py-1 transition-colors hover:text-white">Contact</a></li>
					</ul>
				</nav>

				<nav aria-label="Services">
					<h2 class="text-[0.875rem] font-medium">Services</h2>
					<ul class="mt-5 space-y-3 text-[0.875rem] text-white/55">
						<li>Roof replacement</li>
						<li>Storm and hail restoration</li>
						<li>Repair and maintenance</li>
						<li>Insurance claim support</li>
					</ul>
				</nav>

				<nav aria-label="Service areas">
					<h2 class="text-[0.875rem] font-medium">Areas served</h2>
					<ul class="mt-5 space-y-3 text-[0.875rem] text-white/55">
						{site.areaServed.map((area) => <li>{area}, TX</li>)}
					</ul>
				</nav>
			</div>

			<div class="mt-16 flex flex-col gap-4 border-t border-white/10 pt-8 text-[0.875rem] text-white/60 sm:flex-row sm:items-center sm:justify-between">
				<p>© {year} {site.legalName}. All rights reserved.</p>
				<p>Licensed and insured in the State of Texas.</p>
			</div>
		</div>
	</footer>
</section>

<script>
	/**
	 * Until a real form endpoint is configured, intercept submission and tell
	 * the user how to reach us instead of silently doing nothing (or navigating
	 * to a blank action). Once `action` is set in CtaFooter.astro this becomes
	 * inert and the form posts normally.
	 */
	document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
		if (form.getAttribute('action')) return;

		form.addEventListener('submit', (event) => {
			event.preventDefault();
			const note = form.querySelector<HTMLElement>('[data-form-note]');
			if (note) {
				note.textContent =
					'This demo form has no backend configured yet. Please call (512) 555-0142 or email hello@apexroofing.example.com.';
				note.classList.remove('text-white/60');
				note.classList.add('text-clay-light');
			}
		});
	});
</script>
