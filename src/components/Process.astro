---
import { process } from '../data/site';
---

<section id="process" class="scroll-mt-28 bg-ink py-28 text-white lg:py-40">
	<div class="mx-auto max-w-[88rem] px-6 lg:px-10">
		<div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:items-end">
			<div class="lg:col-span-7">
				<p class="eyebrow text-clay-light" data-reveal>How we work</p>
				<h2
					class="mt-7 font-display text-[clamp(1.9rem,4.2vw,3.4rem)] font-normal leading-[1.06] tracking-[-0.03em] text-balance"
					data-reveal
				>
					Four steps, and a name
					{' '}<span class="text-white/55 italic">attached to each one.</span>
				</h2>
			</div>
			<div class="lg:col-span-4 lg:col-start-9">
				<p class="text-[1.0625rem] leading-relaxed text-white/60 text-pretty" data-reveal>
					You get the same estimator, the same project lead and the same crew
					from first walkthrough to final inspection.
				</p>
			</div>
		</div>

		<ol data-reveal-group class="mt-20 grid grid-cols-1 gap-px overflow-hidden rounded-2xl bg-white/15 sm:grid-cols-2 lg:mt-28 lg:grid-cols-4">
			{
				process.map((item) => (
					<li data-reveal class="group relative bg-ink p-8 transition-colors duration-500 hover:bg-white/[0.04] lg:p-10">
						<span class="font-display text-[2.75rem] leading-none text-clay-light/85">
							{item.step}
						</span>
						<h3 class="mt-8 text-[1.0625rem] font-medium tracking-tight">{item.title}</h3>
						<p class="mt-3.5 text-[0.9375rem] leading-relaxed text-white/60 text-pretty">
							{item.body}
						</p>
						<span
							class="absolute inset-x-8 bottom-0 h-px origin-left scale-x-0 bg-clay-light transition-transform duration-500 group-hover:scale-x-100 lg:inset-x-10"
							aria-hidden="true"
						></span>
					</li>
				))
			}
		</ol>
	</div>
</section>
