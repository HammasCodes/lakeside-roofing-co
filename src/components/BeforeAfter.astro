---
import { Image } from 'astro:assets';
import before from '../assets/projects/ba-before.jpg';
import after from '../assets/projects/ba-after.jpg';

interface Props {
	beforeAlt?: string;
	afterAlt?: string;
	label?: string;
}

const {
	beforeAlt = 'Weathered roof before restoration, shingles dulled and decking exposed',
	afterAlt = 'The same roof after a full system replacement',
	label = 'Reveal the completed roof',
} = Astro.props;
---

{/*
	A native range input is the whole interaction. It gives keyboard support
	(arrows / Home / End), screen reader semantics and touch handling for free.
	A custom pointer-drag handler would have to reimplement all three and would
	still be worse. The script is three lines: mirror the value into a CSS var.

	NOTE ON THE IMAGERY: ba-before.jpg is a colour-graded derivative of
	ba-after.jpg, generated by scripts/prepare-photos.mjs. A real before/after
	pair has to share a camera position or the wipe reads as a jump cut, and no
	genuine pair was available. Swap both files for photographs of an actual
	completed job before this goes in front of customers.
*/}
<figure
	data-ba
	class="group relative select-none overflow-hidden rounded-2xl bg-mist"
	style="--pos: 50%"
>
	<div class="relative aspect-[16/10] lg:aspect-[2/1]">
		<Image
			src={after}
			alt={afterAlt}
			widths={[640, 1000, 1600]}
			sizes="(min-width: 1024px) 88vw, 92vw"
			loading="lazy"
			decoding="async"
			class="absolute inset-0 h-full w-full object-cover"
		/>

		<div class="absolute inset-0" style="clip-path: inset(0 calc(100% - var(--pos)) 0 0)">
			<Image
				src={before}
				alt={beforeAlt}
				widths={[640, 1000, 1600]}
				sizes="(min-width: 1024px) 88vw, 92vw"
				loading="lazy"
				decoding="async"
				class="absolute inset-0 h-full w-full object-cover"
			/>
		</div>

		<span class="pointer-events-none absolute left-5 top-5 rounded-full bg-ink/75 px-3.5 py-1.5 text-[0.6875rem] font-medium uppercase tracking-[0.14em] text-white backdrop-blur-sm">
			Before
		</span>
		<span class="pointer-events-none absolute right-5 top-5 rounded-full bg-clay px-3.5 py-1.5 text-[0.6875rem] font-medium uppercase tracking-[0.14em] text-white">
			After
		</span>

		{/* Divider. Decorative and pointer-events-none so the input owns all input. */}
		<div
			class="pointer-events-none absolute inset-y-0 w-0.5 bg-white shadow-[0_0_16px_rgba(0,0,0,0.4)]"
			style="left: var(--pos); transform: translateX(-50%)"
			aria-hidden="true"
		>
			<span class="absolute left-1/2 top-1/2 flex h-12 w-12 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-white shadow-xl transition-transform duration-300 group-hover:scale-110">
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" class="text-ink">
					<path d="M9 6 4 12l5 6M15 6l5 6-5 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
				</svg>
			</span>
		</div>

		<input
			type="range"
			min="0"
			max="100"
			value="50"
			step="0.5"
			aria-label={label}
			class="absolute inset-0 h-full w-full cursor-ew-resize appearance-none bg-transparent focus-visible:outline-offset-[-3px] [&::-moz-range-thumb]:h-12 [&::-moz-range-thumb]:w-12 [&::-moz-range-thumb]:border-0 [&::-moz-range-thumb]:opacity-0 [&::-webkit-slider-thumb]:h-12 [&::-webkit-slider-thumb]:w-12 [&::-webkit-slider-thumb]:appearance-none [&::-webkit-slider-thumb]:opacity-0"
		/>
	</div>

	<figcaption class="flex flex-wrap items-center justify-between gap-3 px-6 py-5 text-[0.875rem] text-ink/55">
		<span>Brookhaven Residence, Round Rock. Drag or use the arrow keys to compare.</span>
		<span class="text-[0.75rem] uppercase tracking-[0.12em] text-ink/35">
			Demo pair, swap for real job photos
		</span>
	</figcaption>
</figure>

<script>
	document.querySelectorAll<HTMLElement>('[data-ba]').forEach((root) => {
		const input = root.querySelector<HTMLInputElement>('input[type="range"]');
		if (!input) return;

		const sync = () => root.style.setProperty('--pos', `${input.value}%`);
		input.addEventListener('input', sync);
		sync();
	});
</script>
